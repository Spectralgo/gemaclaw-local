{
  "name": "gemaclaw-local",
  "version": "0.1.0",
  "private": true,
  "description": "Run GemaClaw — Gema's household deep-task agent — on your own computer and AI subscription.",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "start": "tsx server/main.ts",
    "dev": "tsx watch server/main.ts",
    "setup": "tsx scripts/setup.ts",
    "pair": "tsx scripts/pair.ts",
    "doctor": "tsx scripts/doctor.ts",
    "desktop:dev": "electron .",
    "desktop:pack": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --dir",
    "desktop:dist": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.1.0",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "dotenv": "^16.4.0",
    "prompts": "^2.4.2",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "tsx": "^4.19.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/prompts": "^2.4.9",
    "@types/qrcode-terminal": "^0.12.2",
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12",
    "playwright-core": "^1.62.1",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20"
  },
  "build": {
    "appId": "com.spectralgo.gemaclaw-local",
    "productName": "GemaClaw Local",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "asar": false,
    "files": [
      "electron/**",
      "assets/**",
      "server/**",
      "scripts/**",
      "package.json",
      "tsconfig.json",
      ".env.example",
      "!**/*.test.ts",
      "!**/*.log",
      "!node_modules/@anthropic-ai/claude-agent-sdk/vendor/ripgrep/x64-darwin/**",
      "!node_modules/@anthropic-ai/claude-agent-sdk/vendor/ripgrep/x64-linux/**",
      "!node_modules/@anthropic-ai/claude-agent-sdk/vendor/ripgrep/arm64-linux/**",
      "!node_modules/@anthropic-ai/claude-agent-sdk/vendor/ripgrep/x64-win32/**"
    ],
    "protocols": [
      {
        "name": "GemaClaw Local",
        "schemes": [
          "gemaclaw"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "identity": null,
      "icon": "assets/icon.icns",
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "extendInfo": {
        "LSUIElement": true
      }
    }
  }
}
